# =================================
# TraceRoute - Backend Configuration
# =================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Get a free cluster at: https://www.mongodb.com/cloud/atlas
# Include a database name (here: traceroute) so each event gets its own database.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/traceroute?appName=Cluster0

# JWT Secret (change this to a random string!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Allowed frontend origins in production (comma-separated). localhost is always allowed.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Admin Account (optional - a random password is generated if not set)
# ADMIN_PASSWORD=your_admin_password
# ADMIN_EMAIL=admin@example.com

# Demo team password used by `npm run seed:teams` (default 123456)
# DEMO_TEAM_PASSWORD=123456

# Make.com Webhook (optional - emails each new team its login details)
# Template + field mapping: docs/EMAIL_TEMPLATE.md
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Separate webhook for admin broadcast emails (Admin -> Broadcast).
# Kept apart from the credentials webhook so the two can never cross over.
# MAKE_BROADCAST_WEBHOOK_URL=https://hook.eu1.make.com/your_broadcast_webhook_id
# Public URL of the frontend, included in the email as the login link
# FRONTEND_URL=https://your-frontend.vercel.app
