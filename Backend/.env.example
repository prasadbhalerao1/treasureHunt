# =================================
# BERLIN HEIST - Backend Configuration
# =================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Get a free cluster at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/treasurehunt

# JWT Secret (change this to a random string!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Account (optional - defaults will be generated if not set)
# ADMIN_PASSWORD=your_admin_password
# ADMIN_EMAIL=admin@example.com

# Make.com Webhook (optional - for team email notifications)
# See DOCUMENTATION.md for setup instructions
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id
