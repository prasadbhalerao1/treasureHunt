{
  "name": "berlin-heist-backend",
  "version": "1.0.0",
  "description": "BERLIN HEIST - QR-based treasure hunt game API",
  "main": "index.js",
  "author": {
    "name": "Prasad Bhalerao",
    "url": "https://www.linkedin.com/in/prasadbhalerao"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "setup:all": "npm run seed:locations && npm run seed:admin && npm run seed:teams && npm run generate:qr && npm run generate:printable",
    "setup:quick": "npm run seed:locations && npm run seed:admin",
    "seed:locations": "node scripts/seedLocations.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:teams": "node scripts/seedTeams.js",
    "generate:qr": "node scripts/generateQRs.js",
    "generate:printable": "node scripts/generatePrintable.js",
    "db:wipe": "node scripts/wipeDb.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "treasure-hunt",
    "qr-code",
    "game",
    "express",
    "mongodb"
  ],
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^8.0.0",
    "nodemailer": "^7.0.12",
    "qrcode": "^1.5.4"
  }
}
